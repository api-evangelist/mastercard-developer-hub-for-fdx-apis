          "request": {
            "name": "Mastercard Developer Hub for FDX APIs Token Introspection Endpoint",
            "description": {
              "content": "This endpoint allows clients to validate an access token and retrieve its metadata, such as its validity, scopes, and associated user details.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth2",
                "introspect"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
